<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>weave</ToolCommandName>
    <AssemblyName>weave</AssemblyName>
    <PackageId>Weave.Cli</PackageId>
    <Description>CLI for Weave — set up AI assistants with guardrails you control.</Description>
  </PropertyGroup>

  <!-- AOT size optimization — applied only during publish -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Weave.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\Weave.Shared\Weave.Shared.csproj" />
    <ProjectReference Include="..\..\Workspaces\Weave.Workspaces\Weave.Workspaces.csproj" />
    <ProjectReference Include="..\..\Deployment\Weave.Deploy\Weave.Deploy.csproj" />
    <ProjectReference Include="..\Weave.Actions\Weave.Actions.csproj" />
    <ProjectReference Include="..\Weave.Cli.Shell\Weave.Cli.Shell.csproj" />
    <ProjectReference Include="..\Weave.Cli.Tui\Weave.Cli.Tui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Implicit using for shared shell primitives so consumers don't repeat
       `using Weave.Cli.Shell;` in every file. -->
  <ItemGroup>
    <Using Include="Weave.Cli.Shell" />
  </ItemGroup>

</Project>
