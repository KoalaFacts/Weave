{
  "name": "demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": {"crons": ["*/5 * * * *"]},
  "rules": [{"type":"Text","globs":["**/*.html","**/*.json","**/*.md"],"fallthrough":true}],
  "d1_databases": [{
    "binding": "db",
    "database_name": "weave-mailbox-demo",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "r2_buckets": [{
    "binding": "EXTERNAL_MEDIA",
    "bucket_name": "weave-external-media"
  }],
  "vars": {
    "EXTERNAL_MEDIA_ORIGIN": "https://demo.weave-389.workers.dev"
  }
}
