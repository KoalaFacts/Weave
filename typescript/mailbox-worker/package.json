{
  "name": "weave-mailbox-worker",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/recovery.ts --bundle --format=esm --platform=browser --outdir=dist --external:node:crypto --external:cloudflare:workers --loader:.html=text --loader:.json=text --loader:.md=text",
    "test": "npm run test:marketplace && npm run build && node --require ./test/local-miniflare.ts --test --test-concurrency=1 test/*.test.ts",
    "test:marketplace": "node ../../scripts/marketplace/marketplace.ts check && node --test ../../scripts/marketplace/marketplace.test.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "dev": "wrangler dev --local",
    "test:compat": "npm run build && node test/compat.ts",
    "test:browser": "npm run build && node --test --test-concurrency=1 test/browser/*.browser.ts",
    "benchmark:hash": "node test/hash-benchmark.ts",
    "build:recovery": "esbuild src/recovery.ts --bundle --format=esm --platform=browser --outfile=dist/recovery.js --external:node:crypto --loader:.html=text --loader:.json=text --loader:.md=text"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
