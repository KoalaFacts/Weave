{
  "name": "weave-auth-worker",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:portable": "node --test test/consent.test.ts test/prepare-demo.test.ts test/human-session.test.ts test/owner-forms.test.ts test/registration-limit.test.ts",
    "build": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir dist",
    "test:workerd": "node --test test/workerd-nonce.test.ts test/workerd-consent-grant.test.ts test/workerd-github-login.test.ts test/workerd-registration.test.ts",
    "prepare:demo": "node scripts/prepare-demo.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "wrangler": "4.149.0",
    "miniflare": "5.20261006.1-alpha"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
