<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotExcluded>true</IsAotExcluded>
    <Description>Orleans ADO.NET grain storage on SQLite for Weave.Silo. Reference this project from a Silo host to make `Weave:ActorStorage:Provider=sqlite` available. SQLite is single-node, so only grain persistence is wired here — clustering stays on UseLocalhostClustering.</Description>
    <RootNamespace>Weave.Silo.Clustering.Sqlite</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sqlite-Main.sql" />
    <EmbeddedResource Include="Sqlite-Persistence.sql" />
  </ItemGroup>
</Project>
