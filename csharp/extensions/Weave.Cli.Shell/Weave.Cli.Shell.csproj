<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Shared shell primitives for the Weave CLI: theme, config readers/writers, workspace registry, version service, and the action-consuming CLI command handlers that both `weave …` invocations and the interactive TUI dispatch through.</Description>
    <RootNamespace>Weave.Cli.Shell</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="weave" />
    <InternalsVisibleTo Include="Weave.Cli.Tui" />
    <InternalsVisibleTo Include="Weave.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Weave.csproj" />
    <ProjectReference Include="../Weave.Actions/Weave.Actions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
</Project>
