@page "/secrets"

<PageTitle>Secrets - Weave</PageTitle>

<FluentText As="TextTag.H4" Style="margin-bottom: 1rem;">Secrets Management</FluentText>

<FluentCard Style="padding: 1rem; margin-bottom: 1.5rem; max-width: 600px; background: var(--colorNeutralBackground2);">
    <FluentText As="TextTag.Paragraph">
        Secret management is handled through the workspace manifest and the configured secrets provider.
        Vault, environment variable, and encrypted file providers are supported.
    </FluentText>
</FluentCard>

<FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Configured Provider</FluentText>
<FluentCard Style="padding: 1rem; max-width: 500px; margin-bottom: 1.5rem;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentText As="TextTag.Paragraph">
            The active secrets provider is determined per workspace by the <code>secrets.provider</code> field in
            <code>workspace.json</code>.
        </FluentText>
        <FluentText As="TextTag.Paragraph">
            Supported values: <strong>env</strong>, <strong>file</strong>, <strong>vault</strong>
        </FluentText>
    </FluentStack>
</FluentCard>

<FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Security Controls</FluentText>
<FluentCard Style="padding: 1rem; max-width: 500px;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentText As="TextTag.Paragraph">&#x2022; Capability tokens gate tool access</FluentText>
        <FluentText As="TextTag.Paragraph">&#x2022; Tool input and output are scanned for leaked secrets</FluentText>
        <FluentText As="TextTag.Paragraph">&#x2022; Secret substitution is performed through the proxy grain</FluentText>
        <FluentText As="TextTag.Paragraph">&#x2022; Invocations are blocked when leak scanning detects exposure</FluentText>
    </FluentStack>
</FluentCard>
