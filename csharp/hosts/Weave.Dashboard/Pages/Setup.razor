@page "/setup"

<PageTitle>Setup Wizard - Weave</PageTitle>

<FluentText As="TextTag.H4" Style="margin-bottom: 1rem;">Setup Wizard</FluentText>

<FluentWizard StepperPosition="StepperPosition.Top"
              Style="height: 600px;">
    <Steps>
        <FluentWizardStep Label="Runtime">
            <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Container Runtime</FluentText>
            <FluentText As="TextTag.Paragraph" Style="margin-bottom: 1rem;">Select your container runtime for workspace isolation.</FluentText>
            <FluentRadioGroup TValue="string" @bind-Value="_runtime">
                <FluentRadio Value="@("podman")" Label="Podman (Recommended)" />
                <FluentRadio Value="@("docker")" Label="Docker" />
                <FluentRadio Value="@("containerd")" Label="containerd" />
                <FluentRadio Value="@("none")" Label="None (in-process only)" />
            </FluentRadioGroup>
        </FluentWizardStep>

        <FluentWizardStep Label="Secrets">
            <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Secrets Provider</FluentText>
            <FluentText As="TextTag.Paragraph" Style="margin-bottom: 1rem;">Choose how secrets are managed.</FluentText>
            <FluentRadioGroup TValue="string" @bind-Value="_secretsProvider">
                <FluentRadio Value="@("env")" Label="Environment Variables (Simple)" />
                <FluentRadio Value="@("file")" Label="Encrypted File" />
                <FluentRadio Value="@("vault")" Label="HashiCorp Vault" />
            </FluentRadioGroup>
        </FluentWizardStep>

        <FluentWizardStep Label="Workspace">
            <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Create First Workspace</FluentText>
            <FluentTextInput @bind-Value="_workspaceName" Label="Workspace Name" Style="margin-bottom: 0.5rem;" />
            <FluentTextInput @bind-Value="_workspacePath" Label="Workspace Path" />
        </FluentWizardStep>

        <FluentWizardStep Label="Review">
            <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Review Configuration</FluentText>
            <div style="margin-bottom: 1rem;">
                <p><strong>Runtime:</strong> @_runtime</p>
                <p><strong>Secrets Provider:</strong> @_secretsProvider</p>
                <p><strong>Workspace Name:</strong> @_workspaceName</p>
                <p><strong>Workspace Path:</strong> @_workspacePath</p>
            </div>
            <FluentButton Appearance="ButtonAppearance.Primary">Complete Setup</FluentButton>
        </FluentWizardStep>
    </Steps>
</FluentWizard>
