<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>weave</ToolCommandName>
    <AssemblyName>weave</AssemblyName>
    <PackageId>Weave.Cli</PackageId>
    <Description>CLI for Weave — set up AI assistants with guardrails you control.</Description>
    <RootNamespace>Weave.Cli</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Weave.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Weave.csproj" />
    <ProjectReference Include="../../extensions/Weave.Deploy/Weave.Deploy.csproj" />
    <ProjectReference Include="../../extensions/Weave.Actions/Weave.Actions.csproj" />
    <ProjectReference Include="../../extensions/Weave.Cli.Shell/Weave.Cli.Shell.csproj" />
    <ProjectReference Include="../../extensions/Weave.Cli.Tui/Weave.Cli.Tui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Weave.Cli.Shell" />
  </ItemGroup>
</Project>
