{
  "name": "demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": {"crons": ["*/5 * * * *"]},
  "rules": [{"type":"Text","globs":["**/*.html","**/*.json","**/*.md"],"fallthrough":true}],
  "d1_databases": [{
    "binding": "db",
    "database_name": "weave-mailbox-demo",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "CLEANUP_MAX_MESSAGES": "0",
    "CLEANUP_TIME_BUDGET_MS": "0",
    "REGISTRATION_ENABLED": "true",
    "REGISTRATION_MAX_ACCOUNTS": "100",
    "REGISTRATION_PER_IP_PER_HOUR": "10",
    "REGISTRATION_GLOBAL_PER_HOUR": "100"
  }
}
