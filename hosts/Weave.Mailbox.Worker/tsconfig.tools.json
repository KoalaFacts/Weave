{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "test/local-miniflare.ts",
    "test/mcp-readme-contract.test.ts",
    "../../examples/mailbox-demo-mcp/*.ts",
    "../../scripts/marketplace/*.ts",
    "../../examples/mailbox-demo-pair/**/*.ts"
  ],
  "exclude": [
    "scripts/data-migrations/**/*.ts"
  ]
}
