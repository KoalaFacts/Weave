@inherits LayoutComponentBase

<div class="dashboard-layout">
    <FluentHeader>
        Weave Dashboard
    </FluentHeader>

    <div class="dashboard-shell">
        <FluentNavMenu Width="250" Title="Navigation">
            <NavMenu />
        </FluentNavMenu>

        <main class="dashboard-content">
            @Body
        </main>
    </div>

    <FluentFooter Class="dashboard-footer">
        <span>Weave v0.1.0 — AI Agent Workspace Orchestrator</span>
    </FluentFooter>
</div>
