@page "/agents"

<PageTitle>Agents - Weave</PageTitle>

<FluentText As="TextTag.H4" Style="margin-bottom: 1rem;">Agent Console</FluentText>

@if (_error is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Style="margin-bottom: 1rem;">@_error</FluentMessageBar>
}

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Style="height: 500px;">
    <FluentCard Style="width: 250px; padding: 1rem;">
        <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">Active Agents</FluentText>
        @if (_loading)
        {
            <FluentSpinner />
        }
        else if (_agents.Count == 0)
        {
            <FluentText As="TextTag.Paragraph">No agents active</FluentText>
        }
        @foreach (var agent in _agents)
        {
            <FluentButton Appearance="@(_selectedAgent?.AgentName == agent.AgentName ? ButtonAppearance.Primary : ButtonAppearance.Subtle)"
                          Style="width: 100%; margin-bottom: 4px;"
                          OnClick="@(() => SelectAgent(agent))">
                @agent.AgentName (@agent.Status)
            </FluentButton>
        }
    </FluentCard>

    <FluentCard Style="flex: 1; padding: 1rem; display: flex; flex-direction: column;">
        <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold" Style="margin-bottom: 0.5rem;">
            @(_selectedAgent?.AgentName ?? "Select an agent")
        </FluentText>

        @if (_selectedAgent is not null)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-bottom: 0.5rem;">
                <FluentBadge Content="@_selectedAgent.Status" />
                @if (_selectedAgent.Model is not null)
                {
                    <FluentBadge Color="BadgeColor.Informative" Content="@_selectedAgent.Model" />
                }
                @foreach (var tool in _selectedAgent.ConnectedTools)
                {
                    <FluentBadge Color="BadgeColor.Informative" Content="@tool" />
                }
            </FluentStack>
        }

        <div style="flex: 1; overflow-y: auto; margin-bottom: 0.5rem;">
            @foreach (var msg in _messages)
            {
                <div style="margin-bottom: 0.5rem;">
                    <FluentText As="TextTag.Paragraph"><strong>@msg.Role:</strong> @msg.Content</FluentText>
                </div>
            }
        </div>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
            <FluentTextInput @bind-Value="_inputMessage" Placeholder="Send message..."
                             Style="flex: 1;" Disabled="@(_selectedAgent is null || _sending)" />
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SendMessage"
                          Disabled="@(_selectedAgent is null || _sending)">
                @(_sending ? "Sending..." : "Send")
            </FluentButton>
        </FluentStack>
    </FluentCard>
</FluentStack>
