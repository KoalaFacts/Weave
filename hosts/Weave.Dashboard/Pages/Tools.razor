@page "/tools"

<PageTitle>Tools - Weave</PageTitle>

<FluentText As="TextTag.H4" Style="margin-bottom: 1rem;">Tool Connections</FluentText>

@if (_loading)
{
    <FluentSpinner />
}
else if (_error is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
}
else if (_tools.Count == 0)
{
    <FluentText As="TextTag.Paragraph">No tools connected. Start a workspace to register tools.</FluentText>
}
else
{
    <FluentDataGrid Items="@_tools.AsQueryable()" GridTemplateColumns="1fr 120px 120px 1fr 160px">
        <PropertyColumn Property="@(t => t.ToolName)" Title="Tool" />
        <PropertyColumn Property="@(t => t.ToolType)" Title="Type" />
        <TemplateColumn Title="Status">
            <FluentBadge Color="@GetStatusColor(context.Status)" Content="@context.Status" />
        </TemplateColumn>
        <PropertyColumn Property="@(t => t.Endpoint)" Title="Endpoint" />
        <PropertyColumn Property="@(t => t.ConnectedAt)" Title="Connected" Format="g" />
    </FluentDataGrid>
}
