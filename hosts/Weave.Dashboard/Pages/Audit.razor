@page "/audit"
@page "/audit/{TokenId}"

<PageTitle>Capability Audit - Weave</PageTitle>

<FluentText As="TextTag.H4" Style="margin-bottom: 1rem;">Capability Audit</FluentText>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-bottom: 1rem;">
    <FluentTextInput @bind-Value="_filterTokenId" Placeholder="Token ID — leave blank for recent rows"
                     Style="flex: 1; max-width: 540px;" />
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="LoadAsync" Disabled="@_loading">
        @(_loading ? "Loading…" : "Load")
    </FluentButton>
    @if (!string.IsNullOrWhiteSpace(_filterTokenId))
    {
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ClearFilter" Disabled="@_loading">Clear</FluentButton>
    }
</FluentStack>

@if (_loading)
{
    <FluentSpinner />
}
else if (_error is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
}
else if (_rows.Count == 0)
{
    <FluentText As="TextTag.Paragraph">
        @(string.IsNullOrWhiteSpace(_filterTokenId)
            ? "No capability authorization rows on this silo yet."
            : "No audit rows recorded for this token. Either it never authorized through this silo, or its rows have been evicted (the in-memory store is bounded and FIFO).")
    </FluentText>
}
else
{
    <FluentText As="TextTag.Paragraph" Style="margin-bottom: 0.5rem; color: var(--colorNeutralForeground3);">
        @_rows.Count row(s)@(string.IsNullOrWhiteSpace(_filterTokenId) ? " — newest first" : $" for token {ShortId(_filterTokenId!)}")
    </FluentText>

    <FluentDataGrid Items="@_rows.AsQueryable()" GridTemplateColumns="160px 80px 1fr 200px 1fr 1fr 160px">
        <PropertyColumn Property="@(r => r.Timestamp)" Title="Time" Format="u" />
        <TemplateColumn Title="Outcome">
            <FluentBadge Color="@GetOutcomeColor(context.Outcome)" Content="@context.Outcome" />
        </TemplateColumn>
        <PropertyColumn Property="@(r => r.Grant)" Title="Grant" />
        <PropertyColumn Property="@(r => r.ActionContext)" Title="Action" />
        <TemplateColumn Title="Reason">
            @(string.IsNullOrEmpty(context.Reason) ? "—" : context.Reason)
        </TemplateColumn>
        <PropertyColumn Property="@(r => r.IssuedTo)" Title="Issued To" />
        <TemplateColumn Title="Token">
            <FluentLink Href="@($"/audit/{context.TokenId}")">
                @ShortId(context.TokenId)
            </FluentLink>
        </TemplateColumn>
    </FluentDataGrid>
}
