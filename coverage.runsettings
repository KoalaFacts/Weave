<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Used when collecting coverage via `dotnet test --collect:"XPlat Code Coverage"
    --settings coverage.runsettings`. The coverlet.msbuild path driven from
    Directory.Build.targets takes precedence on CI; this file keeps local
    VS / Rider / `dotnet test` runs consistent.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Exclude source-generated artefacts and auto-code. -->
          <ExcludeByFile>**/obj/**/*.cs,**/*.g.cs,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>

          <!-- Never count the test assemblies themselves in coverage. -->
          <Exclude>[*.Tests]*,[*]*.Migrations.*</Exclude>

          <!-- Whole-assembly DTO groups that are pure records / state
               models. Including them inflates coverage without saying
               anything about behaviour. Keep this list short. -->
          <ExcludeByFile>**/Models/*.cs,**/Contracts.cs,**/BrandedIds.cs,**/*Surrogate*.cs</ExcludeByFile>

          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
